# HTTP Server
PORT=8787
HOST=127.0.0.1
CORS_ORIGIN=*

# Network & Base JSON-RPC (8453 = Base Mainnet, 84532 = Base Sepolia, 31337 = Local Anvil)
CHAIN_ID=8453
BASE_RPC_URL=https://mainnet.base.org
EXPLORER_BASE_URL=https://basescan.org

# Live Base Mainnet Twin-Genesis Contracts (...5ba3 & ...cba3)
RIG_TOKEN_ADDRESS=0xbfefd4d88899830d756b2678944770a792315ba3
RGG_TOKEN_ADDRESS=0x36376c7058894685507eca5112d04cfb2547cba3

# Deploy via contracts/script/DeployTwinGenesis.s.sol (binding EXISTING_RIG_TOKEN & EXISTING_RGG_TOKEN)
RIG_CONTROLLER_ADDRESS=
RIG_VAULT_ADDRESS=
RIG_X402_ROUTER_ADDRESS=
USDC_TOKEN_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# Optional gasless relayer key for server-side EIP-2612 / EIP-3009 settlement submission
SETTLEMENT_PRIVATE_KEY=

# x402 v2 Pricing (atomic token units: RGG has 18 decimals, USDC has 6 decimals)
# Note: Live Base $RGG (0x3637...cba3) EIP-712 domain name is "RIG" version "1"
X402_RGG_PRICE_ATOMIC=1000000000000000000
X402_USDC_PRICE_ATOMIC=250000
RGG_TOKEN_NAME=RIG
RGG_TOKEN_VERSION=1
USDC_TOKEN_NAME=USD Coin
USDC_TOKEN_VERSION=2

# Telemetry Indexer (keep lookback small on public RPC to prevent 429 rate limits)
POLL_INTERVAL_MS=4000
INDEXER_LOOKBACK_BLOCKS=25
MAX_TELEMETRY_EVENTS=200
